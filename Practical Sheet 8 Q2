package javaapplication222;

public class JavaApplication222 {

    public static void main(String[] args) {

        PrintedBook book = new PrintedBook(
                1, "Java Programming", 2023, "Ahmed", 300
        );

        DigitalResource digital = new DigitalResource(
                2, "Java PDF", 2024, "PDF", 15.5
        );

        book.displayInfo();

        digital.displayInfo();

        System.out.println("Book Late Fee: " +
                book.calculateLateFee(5));

        System.out.println("Digital Late Fee: " +
                digital.calculateLateFee(5));

        System.out.println("Book Discount: " +
                book.calculateLateFee(5, 0.10));

        System.out.println("Digital Discount: " +
                digital.calculateLateFee(5, 0.10));

        System.out.println(book);

        System.out.println(digital);

        LibraryItem item = new PrintedBook(
                3, "OOP", 2025, "Mohamed", 250
        );

        System.out.println("Parent Reference Late Fee: " +
                item.calculateLateFee(5));
    }
}


package javaapplication222;

public class LibraryItem {

    private int itemId;
    private String title;
    private int publicationYear;

    public LibraryItem(int itemId, String title, int publicationYear) {
        this.itemId = itemId;
        this.title = title;
        this.publicationYear = publicationYear;
    }

    public int getItemId() {
        return itemId;
    }

    public void setItemId(int itemId) {
        this.itemId = itemId;
    }

    public String getTitle() {
        return title;
    }

    public void setTitle(String title) {
        this.title = title;
    }

    public int getPublicationYear() {
        return publicationYear;
    }

    public void setPublicationYear(int publicationYear) {
        this.publicationYear = publicationYear;
    }

    public double calculateLateFee(int days) {
        return days * 5;
    }

    public double calculateLateFee(int days, double discount) {
        return calculateLateFee(days) * (1 - discount);
    }

    public void displayInfo() {
        System.out.println("Item ID: " + itemId);
        System.out.println("Title: " + title);
        System.out.println("Publication Year: " + publicationYear);
    }

    @Override
    public String toString() {
        return "Item ID: " + itemId +
               ", Title: " + title +
               ", Publication Year: " + publicationYear;
    }
}


package javaapplication222;

public class PrintedBook extends LibraryItem {

    private String author;
    private int numberOfPages;

    public PrintedBook(int itemId, String title, int publicationYear,
                       String author, int numberOfPages) {

        super(itemId, title, publicationYear);
        this.author = author;
        this.numberOfPages = numberOfPages;
    }

    public String getAuthor() {
        return author;
    }

    public void setAuthor(String author) {
        this.author = author;
    }

    public int getNumberOfPages() {
        return numberOfPages;
    }

    public void setNumberOfPages(int numberOfPages) {
        this.numberOfPages = numberOfPages;
    }

    @Override
    public double calculateLateFee(int days) {
        return days * 7;
    }

    @Override
    public void displayInfo() {
        super.displayInfo();
        System.out.println("Author: " + author);
        System.out.println("Number of Pages: " + numberOfPages);
    }

    @Override
    public String toString() {
        return super.toString() +
               ", Author: " + author +
               ", Pages: " + numberOfPages;
    }
}


package javaapplication222;

public class DigitalResource extends LibraryItem {

    private String fileFormat;
    private double fileSize;

    public DigitalResource(int itemId, String title, int publicationYear,
                           String fileFormat, double fileSize) {

        super(itemId, title, publicationYear);
        this.fileFormat = fileFormat;
        this.fileSize = fileSize;
    }

    public String getFileFormat() {
        return fileFormat;
    }

    public void setFileFormat(String fileFormat) {
        this.fileFormat = fileFormat;
    }

    public double getFileSize() {
        return fileSize;
    }

    public void setFileSize(double fileSize) {
        this.fileSize = fileSize;
    }

    @Override
    public double calculateLateFee(int days) {
        return days * 3;
    }

    @Override
    public void displayInfo() {
        super.displayInfo();
        System.out.println("File Format: " + fileFormat);
        System.out.println("File Size: " + fileSize);
    }

    @Override
    public String toString() {
        return super.toString() +
               ", File Format: " + fileFormat +
               ", File Size: " + fileSize;
    }
}
